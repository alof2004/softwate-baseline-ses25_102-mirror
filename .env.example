POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_pass

DB_PORT=5432
# BACKEND_PORT is intentionally not exposed — all traffic must go through the WAF.
# Uncomment only for local debugging without WAF.
# BACKEND_PORT=8080
FRONTEND_PORT=5173
DAST_BACKEND_PORT=18080
DAST_FRONTEND_PORT=15173

# WAF (Nginx + ModSecurity) — the only public entry point to the API
WAF_HTTP_PORT=8080
WAF_HTTPS_PORT=8443

SPRING_JPA_HIBERNATE_DDL_AUTO=update

# CORS: allowed origins for the backend (WAF origin in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:8443

VITE_API_BASE_URL=https://localhost:8443/api

# Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak OIDC — browser-visible URL (used for iss claim validation and frontend init)
VITE_KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/clinic
# Backend reaches Keycloak via internal Docker network for JWKS key fetching
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/clinic/protocol/openid-connect/certs
