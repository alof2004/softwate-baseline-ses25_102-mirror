POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_pass

DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
DAST_BACKEND_PORT=18080
DAST_FRONTEND_PORT=15173

SPRING_JPA_HIBERNATE_DDL_AUTO=update

VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://backend:8080

# Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak OIDC — browser-visible URL (used for iss claim validation and frontend init)
VITE_KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/clinic
# Backend reaches Keycloak via internal Docker network for JWKS key fetching
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/clinic/protocol/openid-connect/certs
